# Clerk (public JWT verification for API; publishable key for the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…
CLERK_PUBLISHABLE_KEY=pk_test_…
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----"
CLERK_ISSUER_URL=https://<frontend-api>.clerk.accounts.dev
APP_ORIGINS=http://localhost:3000,https://<your-vercel-app>.vercel.app

# Supabase project (dashboard / API keys). Never expose the service role to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ…
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ…

# Prisma → Supabase Postgres (required for Next.js /api at scale)
# DATABASE_URL: transaction pooler :6543 ?pgbouncer=true&connection_limit=1 (Vercel serverless)
# DIRECT_URL: session pooler :5432 (migrate / introspect)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: proxy /api to local Wrangler+D1 instead of Next route handlers
# USE_WORKER_API=1

# Optional AI (Workers AI is not available on Vercel; demo mode is the default)
# AI_PROVIDER=anthropic|opencode
# ANTHROPIC_API_KEY=
# OPENCODE_API_KEY=
