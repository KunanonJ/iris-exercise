# Copy to .dev.vars for local dev (wrangler and `pnpm eval` both read it).
# No key = demo mode (scripted coach, rules-based path).

# Option A (free): Cloudflare Workers AI. `wrangler dev` uses the AI binding; `pnpm eval` needs a token
# AI_PROVIDER=workers-ai
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=           # API token with Workers AI permission
# Option B: OpenCode gateway (https://opencode.ai). Needs credits; its free models are app-only.
# OPENCODE_API_KEY=
# Option C: Anthropic directly
# ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=opencode            # force a provider: workers-ai | opencode | anthropic
# COACH_MODEL=                    # e.g. @cf/qwen/qwen3-30b-a3b-fp8, kimi-k2.6, claude-sonnet-5-5
# PATH_MODEL=
# CLASSIFIER_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-sonnet-5-5
# OPENCODE_BASE_URL=https://opencode.ai/inference/v1
# OPENCODE_API_STYLE=messages     # or chat; normally detected from the model id
# DEMO_PASSCODE=                  # gate the whole site behind a passcode
# DAILY_LIMIT=1500
# DEMO_MODE=1                     # force demo mode even with a key
