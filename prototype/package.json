{
  "name": "prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "concurrently -k -n web,api -c cyan,magenta \"USE_WORKER_API=1 next dev\" \"wrangler dev --config wrangler.sandbox.jsonc --local --persist-to .wrangler/suite-v2 --port 8797 --inspector-port 0\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "build": "prisma generate && next build",
    "build:worker": "WORKER_STATIC_EXPORT=1 next build",
    "lint": "eslint",
    "data": "tsx scripts/generate-mock-data.ts",
    "eval": "tsx scripts/eval.ts",
    "preview": "next build && next start",
    "deploy": "vercel --prod",
    "deploy:worker": "pnpm build:worker && wrangler deploy",
    "predev": "mkdir -p out",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs src/components/__tests__/*.test.ts",
    "test:integration": "node --import tsx --test tests/integrations*.test.ts tests/integrations*.test.mjs tests/workflows.test.mjs",
    "sandbox:provision": "tsx scripts/provision-sandbox.ts",
    "supabase:provision": "node --import tsx scripts/provision-supabase.ts",
    "eval:release": "tsx scripts/eval.ts --live --release",
    "sandbox:verify": "tsx scripts/verify-suite-integrations.ts",
    "sandbox:connect": "tsx scripts/configure-local-integrations.ts",
    "sso:enable": "tsx scripts/enable-google-line-sso.ts",
    "sso:sync-env": "tsx scripts/sync-clerk-local-env.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@clerk/backend": "^3.23.2",
    "@clerk/react": "^6.17.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.145.0"
  },
  "packageManager": "pnpm@10.33.0"
}
